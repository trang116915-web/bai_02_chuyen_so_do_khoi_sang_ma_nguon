#include <stdio.h>
#include <math.h>
int main() { 
    int n;
    scanf("%d", &n);
    if (n < 2) {
       printf("%d khong phai la so nguyen to.",n);
       return 0;
    }
    int dkien = 1;
    for (int i = 2; i * i <= n; i++) {
        if (n % i == 0) {
            dkien = 0;
            break;
        }
    }
    if (dkien) {
       printf("%d la so nguyen to.", n);
    }
    return 0;
}
